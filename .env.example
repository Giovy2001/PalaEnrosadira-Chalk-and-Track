# Configurazione di esempio — copiare in .env e sostituire i valori.
# NON committare il file .env con segreti reali.

# Modalita' app: "local" oppure "production". Su Vercel viene rilevata automaticamente.
APP_ENV=local

# Segreto per sessioni Flask e token di login. OBBLIGATORIO in produzione.
# Generare con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Segreto per il cron di pulizia (/api/database_cleanup). Se vuoto il cron e' disabilitato.
CRON_SECRET=

# Migrazione una tantum: 1 per consentire ai profili storici senza token di
# reclamare il proprio username. Disattivare dopo la migrazione.
# ALLOW_LEGACY_CLAIM=0

# Turso (necessari in produzione)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob (necessari in produzione per le immagini)
BLOB_READ_WRITE_TOKEN=

# Opzionali: override percorsi e upload
# LOCAL_DB_PATH=static/local_database/sql_database.db
# LOCAL_IMAGES_DIR=static/local_database/Images
# FLASK_DEBUG=1
